# =====================================================
# Development Environment Configuration for EC2
# =====================================================

# =====================================================
# 애플리케이션 설정 (Application Settings)
# =====================================================
ENV=development
APP_TITLE=BootRun API (Dev)
APP_VERSION=1.0.0
DEBUG=True
APP_PORT=8000
APP_HOST=0.0.0.0
WORKERS_COUNT=2


# =====================================================
# 데이터베이스 (PostgreSQL) - Docker internal
# =====================================================
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=bootrun_db
DATABASE_USER=bootrun_user
DATABASE_PASSWORD=dev_postgres_password_change_me
DATABASE_ECHO=False
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5


# =====================================================
# Redis 캐시 - Docker internal
# =====================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=dev_redis_password_change_me
REDIS_TIMEOUT=5


# =====================================================
# JWT 인증
# =====================================================
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_12345
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_EMAIL_VERIFY_TOKEN_EXPIRE_MINUTES=1440
JWT_RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=30


# =====================================================
# 암호화 설정 (Fernet)
# To generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =====================================================
FERNET_KEY=YOUR_FERNET_KEY_HERE_GENERATE_WITH_COMMAND_ABOVE


# =====================================================
# OpenAI / LangChain 챗봇 설정
# =====================================================
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-3.5-turbo
CHATBOT_TEMPERATURE=0.7
CHATBOT_MAX_TOKENS=1000
CHATBOT_MEMORY_BUFFER_SIZE=5


# =====================================================
# AWS S3 설정 (동영상 저장) - USE YOUR ACTUAL AWS CREDENTIALS
# =====================================================
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=bootrun-videos-dev
S3_VIDEOS_FOLDER=videos
S3_IMAGES_FOLDER=images


# =====================================================
# CORS 설정 - IMPORTANT FOR FRONTEND COLLABORATION
# Add your frontend dev server URL here
# =====================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://YOUR_EC2_PUBLIC_IP:3000
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=Content-Type,Authorization,Accept,Origin,X-Requested-With


# =====================================================
# 로깅 설정
# =====================================================
LOG_LEVEL=DEBUG
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=50
LOG_RETENTION_DAYS=7


# =====================================================
# 이메일 설정 (선택사항 - Dev에서는 건너뛰어도 됨)
# =====================================================
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASSWORD=your_email_app_password
EMAIL_FROM_ADDRESS=noreply@bootrun.com
EMAIL_FROM_NAME=BootRun Dev


# =====================================================
# 결제 시스템 (Toss Payments) - Test API Keys
# =====================================================
TOSS_CLIENT_KEY=test_ck_your_test_client_key
TOSS_SECRET_KEY=test_sk_your_test_secret_key
TOSS_API_URL=https://api.tosspayments.com/v1


# =====================================================
# 파일 업로드 설정
# =====================================================
MAX_UPLOAD_SIZE_MB=100
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,mkv,webm
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx


# =====================================================
# 시간대 및 국제화
# =====================================================
TIMEZONE=Asia/Seoul
DEFAULT_LANGUAGE=ko
